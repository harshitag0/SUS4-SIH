{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ml",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "services/ml", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/src/index.js"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["client/node_modules/vite/bin/vite.js", "client", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
