PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/agrilink
ML_URL=http://127.0.0.1:8000
JWT_SECRET=change-me
USD_INR=88
# Demo OTP accepted for every mobile number. Replace with an SMS provider (MSG91/Twilio) in production.
DEV_OTP=1234
SEED_ON_START=true

# ---------------- Farmer messaging (WhatsApp / SMS / voice) ----------------
# auto = use a channel live only when its credentials are set, simulate the rest (default)
# simulated = never call providers (development/testing) · live = providers required, missing ones fail visibly
MESSAGING_MODE=auto
# Public base URL of this API (provider status callbacks) and of the web app (QR codes)
PUBLIC_API_URL=
PUBLIC_APP_URL=http://localhost:5173

# WhatsApp Business Cloud API (Meta). Templates named agrilink_<key> must be approved per language (see messaging/templates.js)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_PREFIX=agrilink_
WHATSAPP_APP_SECRET=          # verifies X-Hub-Signature-256 on /api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=        # your choice; entered in the Meta webhook setup

# SMS gateway: msg91 | twilio | http
SMS_PROVIDER=
SMS_SENDER_ID=                # DLT-registered 6-letter header (India)
SMS_DLT_ENTITY_ID=            # DLT principal entity id (India)
SMS_DLT_TEMPLATE_IDS={}       # JSON: {"quality_warning:mr":"1707...","quality_warning":"1707..."} — unregistered messages are refused
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=                 # generic gateway: POST {to, message, dltTemplateId, entityId, senderId, unicode}
SMS_HTTP_TOKEN=
SMS_WEBHOOK_TOKEN=            # required on delivery-report callbacks: /api/webhooks/sms?token=...&provider=...

# Regional-language voice notes (optional; sent only inside WhatsApp's 24-hour window)
TTS_PROVIDER=                 # google
GOOGLE_TTS_API_KEY=

# Farmer chat assistant ("Mitra"). Without a key it runs in basic mode (fixed answers from the farmer's own data).
GROQ_API_KEY= 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
ASSISTANT_MODEL=claude-haiku-5-5    # fast chat model (default); use claude-sonnet-5-5 for deeper answers
ASSISTANT_MODE=                   # "basic" forces basic mode
WHATSAPP_BUSINESS_NUMBER=         # digits with country code, e.g. 919812345678 — powers the "Chat on WhatsApp" buttons
# Chat provider override (e.g. a router/gateway). Leave empty to use ANTHROPIC_API_KEY directly.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
